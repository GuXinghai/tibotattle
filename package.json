{
  "name": "app-usagemonitor",
  "version": "0.1.27",
  "private": true,
  "type": "module",
  "description": "Local-first coding-agent usage analysis for Windows.",
  "license": "MIT",
  "bin": {
    "usage-monitor": "./src/cli.js"
  },
  "scripts": {
    "architecture:check": "node ./scripts/check-architecture-boundaries.mjs",
    "benchmark:r7:smoke": "node ./src/cli.js benchmark-r7 --profile smoke --output .usage-monitor/r7-resource-benchmark-smoke-v0.1.json",
    "build:prospective-transitions": "node ./tools/reports/build-prospective-collector-transitions.js",
    "build:quality-report-data": "node ./src/build-monitoring-quality-report.js",
    "build:report-data": "node ./src/build-multi-surface-report.js",
    "build:rolling-history": "node ./src/build-rolling-quota-history.js",
    "build:simple-report-data": "node ./src/build-simple-quota-gradient-report.js",
    "build:weekly-calibration-audit": "node ./src/build-weekly-calibration-audit.js",
    "build:weekly-calibration-report-data": "node ./src/build-weekly-calibration-report.js",
    "calibrate:weekly": "node ./src/cli.js calibrate-weekly --input .usage-monitor/transitions-simple-history-2026-06-11-to-2026-07-24-v0.3.2.json --output .usage-monitor/weekly-calibration-v0.2.json --report-file .usage-monitor/2026-07-24-weekly-calibration-v0.2.md",
    "capture": "node ./src/cli.js capture",
    "check": "npm run docs:check && npm test && npm run product:check",
    "codex:contract:check": "node ./scripts/check-codex-contract-drift.mjs",
    "codex:contract:record-installed": "node ./scripts/check-codex-contract-drift.mjs --installed --require-binary --update-ledger",
    "codex:contract:release:check": "node ./scripts/check-codex-contract-drift.mjs --installed --require-binary",
    "collect-foreground": "node ./src/cli.js collect-foreground",
    "collect-once": "node ./src/cli.js collect-once",
    "contamination": "node ./src/cli.js contamination",
    "crosscheck": "node ./src/cli.js crosscheck",
    "diagnose:dashboard": "node ./scripts/inspect-dashboard-state.mjs",
    "docs:api:check": "node --test test/api-surface-reference.test.js",
    "docs:check": "node ./tools/operations/validate-documentation.mjs",
    "docs:links:check": "node ./tools/operations/validate-documentation.mjs --links-only",
    "docs:links:fix": "node ./tools/operations/fix-doc-links.mjs",
    "doctor": "node ./src/cli.js doctor",
    "evaluate:minimization": "node ./scripts/minimization-ablation.js --input .usage-monitor/transitions-v0.3.2.json --output .usage-monitor/minimization-ablation-v0.1.json --prospective-after 2026-07-24T00:00:00.000Z --fixture test/fixtures/minimization-codex-shaped-v1.json --fixture test/fixtures/minimization-claude-shaped-v1.json",
    "experiment": "node ./src/cli.js experiment",
    "export:local": "node ./src/cli.js export-local",
    "fix:report-width": "node ./src/fix-portable-report-width.js",
    "history": "node ./src/cli.js history",
    "i18n:browser:check": "node ./scripts/generate-i18n-browser-mirror.js --check",
    "i18n:browser:generate": "node ./scripts/generate-i18n-browser-mirror.js",
    "i18n:electron:check": "node ./scripts/generate-i18n-electron-copy.js --check",
    "i18n:electron:generate": "node ./scripts/generate-i18n-electron-copy.js",
    "infer": "node ./src/cli.js infer",
    "inspect:export": "node ./src/cli.js inspect-export",
    "mark:activity": "node ./src/cli.js mark-activity",
    "migrate-corrections": "node ./src/cli.js migrate-corrections",
    "migrate:legacy-reports": "node ./scripts/migrate-local-legacy-reports.mjs",
    "package:electron:development": "node ./scripts/package-electron-development.mjs",
    "package:electron:production:prepare": "node ./scripts/package-electron-production.mjs",
    "product:check": "pnpm run architecture:check && pnpm run codex:contract:check && pnpm run tools:inventory:check && pnpm run i18n:browser:check && pnpm run i18n:electron:check && pnpm run telemetry:browser:check && pnpm run telemetry:upload-schemas:check && pnpm run product:ui:test && pnpm run product:electron:test && pnpm run product:local:test",
    "product:electron:test": "node --test --test-concurrency=1 apps/electron/test/*.test.mjs",
    "product:local": "node ./apps/local/server.js",
    "product:local:test": "node --test --test-concurrency=1 test/local-companion-data.test.js test/local-companion-refresh.test.js test/local-contribution-preparation.test.js test/real-local-backend-acceptance.test.js test/telemetry-contribution-builder.test.js test/contribution-device-sync.test.js test/contribution-sync-queue.test.js apps/local/*.test.mjs",
    "product:prepare-contribution": "node ./scripts/build-telemetry-contributions.js",
    "product:ui:test": "node --test apps/web/test/*.test.mjs",
    "quality": "node ./src/cli.js quality",
    "release:evidence:generate": "node ./scripts/generate-release-evidence.js",
    "release:evidence:validate": "node ./scripts/generate-release-evidence.js --validate",
    "release:trust:check": "npm run codex:contract:check && node --test test/codex-contract-drift.test.js test/release-workflow-policy.test.js test/release-evidence.test.js test/release-attestation-action.test.js test/release-sbom-action.test.js",
    "report": "node ./src/cli.js report",
    "rotate:identity": "node ./src/cli.js rotate-local-identity",
    "telemetry:browser:check": "node ./scripts/generate-telemetry-browser-mirror.js --check",
    "telemetry:browser:generate": "node ./scripts/generate-telemetry-browser-mirror.js",
    "telemetry:check": "node ./scripts/generate-telemetry-contract.js --check && node --test test/telemetry-contract.test.js test/export-schema.test.js",
    "telemetry:generate": "node ./scripts/generate-telemetry-contract.js",
    "telemetry:upload-schemas:check": "node ./packages/telemetry-contract/scripts/sync-json-schemas.mjs --check",
    "telemetry:upload-schemas:generate": "node ./packages/telemetry-contract/scripts/sync-json-schemas.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js apps/web/test/*.test.mjs",
    "test:changed": "node ./scripts/test-lanes.mjs changed",
    "test:changed:full": "node ./scripts/test-lanes.mjs changed --full",
    "test:portable": "node ./scripts/test-lanes.mjs portable",
    "test:preflight": "npm run tools:root-workspace:check && node ./scripts/test-lanes.mjs preflight",
    "tools": "node ./src/cli.js tools",
    "tools:inventory:check": "node ./tools/operations/check-tool-inventory.mjs",
    "tools:root-workspace:check": "node ./scripts/check-root-workspace-hygiene.mjs",
    "transitions": "node ./src/cli.js transitions",
    "verify:weekly-calibration": "node ./src/verify-weekly-calibration.js",
    "product:local:acceptance": "node ./scripts/run-real-local-backend-acceptance.js"
  },
  "dependencies": {
    "@app-usagemonitor/accounting": "workspace:*",
    "@app-usagemonitor/i18n": "workspace:*",
    "@app-usagemonitor/identity-core": "workspace:*",
    "@app-usagemonitor/quota-analysis": "workspace:*",
    "@app-usagemonitor/telemetry-contract": "workspace:*",
    "@github/keytar": "7.10.6",
    "ajv": "^8.20.0",
    "ccusage": "20.0.18",
    "electron-updater": "6.8.9",
    "hls.js": "1.7.3",
    "runcost": "0.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "electron": "43.5.0",
    "electron-builder": "26.15.7",
    "es-module-lexer": "2.3.1",
    "fast-check": "^4.9.0"
  }
}
