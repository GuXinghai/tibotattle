{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/local-export-v1/bundle.schema.json",
  "title": "Local review metadata bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compatibility",
    "bundleId",
    "participantId",
    "createdAt",
    "coveredAt",
    "sourceProviders",
    "clientPlatform",
    "transportReady",
    "recordCounts",
    "records",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "local-usage-metadata-bundle-v1"
    },
    "compatibility": {
      "$ref": "https://app-usagemonitor.local/schemas/local-export-v1/compatibility.schema.json"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^bundle:v1:[a-f0-9]{64}$"
    },
    "participantId": {
      "type": "string",
      "pattern": "^participant:v1:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "coveredAt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startAt",
        "endAt"
      ],
      "properties": {
        "startAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        }
      }
    },
    "sourceProviders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "openai_codex"
      }
    },
    "clientPlatform": {
      "const": "windows"
    },
    "transportReady": {
      "const": false
    },
    "recordCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageEvents",
        "quotaSnapshots",
        "activityMarkers"
      ],
      "properties": {
        "usageEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "quotaSnapshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "activityMarkers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageEvents",
        "quotaSnapshots",
        "activityMarkers"
      ],
      "properties": {
        "usageEvents": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "https://app-usagemonitor.local/schemas/local-export-v1/usage-event.schema.json"
          }
        },
        "quotaSnapshots": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "https://app-usagemonitor.local/schemas/local-export-v1/quota-snapshot.schema.json"
          }
        },
        "activityMarkers": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "https://app-usagemonitor.local/schemas/local-export-v1/activity-marker.schema.json"
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFilesScanned",
        "codes"
      ],
      "properties": {
        "sourceFilesScanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "codes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "count"
            ],
            "properties": {
              "code": {
                "enum": [
                  "collector_empty_lines",
                  "collector_irrelevant_records",
                  "collector_out_of_bounds_records",
                  "collector_oversized_irrelevant_lines",
                  "collector_unsupported_schema_records",
                  "collector_unsupported_source_records",
                  "cumulative_prefix_unattributed",
                  "fork_replay_events_skipped",
                  "last_only_events",
                  "lineage_parents_missing",
                  "malformed_lines",
                  "malformed_rate_limit_records",
                  "malformed_task_events",
                  "malformed_timestamps",
                  "malformed_usage_records",
                  "missing_rate_limit_records",
                  "replayed_events_skipped",
                  "replayed_tool_calls_skipped",
                  "response_unverified_prefix_turns",
                  "unattached_tool_calls",
                  "unattributed_fork_replay_events_skipped"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  }
}
