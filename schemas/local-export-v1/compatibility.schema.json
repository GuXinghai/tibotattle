{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/local-export-v1/compatibility.schema.json",
  "title": "Local usage export compatibility tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tupleVersion",
    "schemas",
    "fieldContract",
    "implementation",
    "providerAdapters",
    "registry",
    "contract"
  ],
  "properties": {
    "tupleVersion": {
      "const": "local-export-compatibility-v1"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setSha256",
        "members"
      ],
      "properties": {
        "setSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "members": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "id",
              "sha256"
            ],
            "properties": {
              "name": {
                "enum": [
                  "activity-marker.schema.json",
                  "bundle.schema.json",
                  "compatibility.schema.json",
                  "privacy-receipt.schema.json",
                  "quota-snapshot.schema.json",
                  "usage-event.schema.json"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^https://app-usagemonitor\\.local/schemas/local-export-v1/[a-z-]+\\.schema\\.json$",
                "maxLength": 128
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "fieldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "local-export-field-dictionary-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exporterVersion",
        "resourcePolicyVersion",
        "checkpointParserVersion",
        "checkpointScanVersion",
        "packageName",
        "packageVersion"
      ],
      "properties": {
        "exporterVersion": {
          "const": "0.3.0-draft.3"
        },
        "resourcePolicyVersion": {
          "const": "g1-r3-candidate-0.5"
        },
        "checkpointParserVersion": {
          "const": "codex-checkpoint-state-v0.3"
        },
        "checkpointScanVersion": {
          "const": "codex-export-checkpoint-scan-v0.9"
        },
        "packageName": {
          "const": "app-usagemonitor"
        },
        "packageVersion": {
          "const": "0.1.27"
        }
      }
    },
    "providerAdapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openaiCodex"
      ],
      "properties": {
        "openaiCodex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "capabilities",
            "sourceFormats"
          ],
          "properties": {
            "status": {
              "const": "implemented"
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "usageEvents",
                "quotaSnapshots"
              ],
              "properties": {
                "usageEvents": {
                  "const": "implemented"
                },
                "quotaSnapshots": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rollout",
                    "collector"
                  ],
                  "properties": {
                    "rollout": {
                      "const": "implemented"
                    },
                    "collector": {
                      "const": "implemented"
                    }
                  }
                }
              }
            },
            "sourceFormats": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rollout",
                "collectorQuota"
              ],
              "properties": {
                "rollout": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "sourceFormat",
                    "parserVersion",
                    "adapterVersion"
                  ],
                  "properties": {
                    "status": {
                      "const": "implemented"
                    },
                    "sourceFormat": {
                      "const": "codex-rollout-jsonl"
                    },
                    "parserVersion": {
                      "const": "codex-log-scan-v13"
                    },
                    "adapterVersion": {
                      "const": "codex-metadata-export-v6"
                    }
                  }
                },
                "collectorQuota": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "sourceFormat",
                    "parserVersion",
                    "adapterVersion"
                  ],
                  "properties": {
                    "status": {
                      "const": "implemented"
                    },
                    "sourceFormat": {
                      "const": "codex-collector-jsonl-v0.3"
                    },
                    "parserVersion": {
                      "const": "codex-collector-quota-candidate-v0.1"
                    },
                    "adapterVersion": {
                      "const": "quota-candidate-normalizer-v0.1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "local-export-registry-2026-10-31.1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "status",
        "transportReady",
        "backwardCompatibility"
      ],
      "properties": {
        "family": {
          "const": "local-export-v1"
        },
        "status": {
          "const": "local_only"
        },
        "transportReady": {
          "const": false
        },
        "backwardCompatibility": {
          "const": "none"
        }
      }
    }
  }
}
