{
  "manifest_version": 3,
  "name": "TiboTattle · X 会话导入",
  "version": "1.0.0",
  "description": "用户主动操作时，通过本机通信将 X 会话导入 TiboTattle。",
  "key": "",
  "minimum_chrome_version": "119",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://*.x.com/*"
  ],
  "incognito": "not_allowed",
  "action": {
    "default_title": "X 会话导入",
    "default_popup": "popup.html"
  }
}
